<Project Sdk="Microsoft.NET.Sdk">
  <!-- 學生檔檢查：只編譯 core、examples 與 students.g.props 列出的學生檔（由 gen_host.py 檢查模式產生） -->
  <Import Project="students.g.props" Condition="Exists('students.g.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Smoke.cs" />
    <Compile Include="..\..\core\*.cs" />
    <Compile Include="..\..\examples\*.cs" />
    <Reference Include="RhinoCommon">
      <HintPath>C:\Program Files\Rhino 8\System\RhinoCommon.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
