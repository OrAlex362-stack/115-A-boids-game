<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\core\*.cs" />
    <!-- 編譯錯誤與無窮迴圈的檔不放進來（它們由 gen_host 的檢查擋掉）；其他會出執行期錯誤的照放 -->
    <Compile Include="students\*.cs" Exclude="students\boid_bad_syntax.cs;students\boid_bad_loop.cs" />
    <Reference Include="RhinoCommon">
      <HintPath>C:\Program Files\Rhino 8\System\RhinoCommon.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
</Project>
